# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM API (Google AI Studio / OpenAI compatible)
# Google AI Studio: https://aistudio.google.com/apikey
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Notion API
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Feishu Bot (飞书机器人 Webhook)
FEISHU_WEBHOOK_URL=your_feishu_webhook_url_here

# GitHub Token (optional, for higher API rate limits)
GITHUB_TOKEN=your_github_token_here

# Bilibili Cookie (SESSDATA + bili_jct + buvid3)
BILIBILI_COOKIE=SESSDATA=xxx; bili_jct=xxx; buvid3=xxx

# Twitter/X auth_token (from browser cookie)
TWITTER_AUTH_TOKEN=your_twitter_auth_token_here

# Twitter/X ct0 cookie (paired with auth_token, used by twikit trending collector)
TWITTER_CT0=your_twitter_ct0_cookie_here

# RSSHub (for subscribe analyzer, optional)
RSSHUB_URL=http://localhost:1200

# SQLite path (optional, defaults to ./data/news.db)
NEWS_DB_PATH=./data/news.db
